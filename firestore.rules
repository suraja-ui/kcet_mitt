rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── examAnswers: ONLY server-side Admin SDK can read/write ──────────────
    match /examAnswers/{examId} {
      allow read, write: if false; // Block all client access — Admin SDK bypasses this
    }

    // ─── submissions: Student can create once, cannot update ─────────────────
    match /submissions/{docId} {
      allow read: if false; // Only server reads
      allow create: if false; // Only server creates (via Admin SDK)
      allow update, delete: if false;
    }

    // ─── leaderboard: Anyone can read (public), only server writes ───────────
    match /leaderboard/{docId} {
      allow read: if true;  // Public leaderboard
      allow write: if false; // Only server writes via Admin SDK
    }
  }
}
